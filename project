// Voter Registration & 18+ Check
void displayheader(){
   printf("========================================\n");
    printf("   FAST NATIONAL UNIVERSITY OF COMPUTER      \n");
    printf("     AND EMERGING SCIENCES (KARACHI)    \n");
    printf("       PROGRAMMING FUNDAMENTALS         \n");
