}

int registervoter(voter voters[], int*totalvoters){
    if(*totalvoters>=Max_VOTERS){
        return 0;
    }
    voter newvoter;
    printf("\n VOTER REGISRATION POTAL\n");
    printf("enter voter id");
    scanf("%d",&newvoter.voterid);
     // Check for duplicate ID using pointer/loop logic
    for(int i=0;i<*totalvoters;i++){
        if(voters[i].voterid==newvoter.voterid){
            printf("voter id alraady exists!");
            return 0;
        }
    }
    printf("enter voter name:");
    scanf(" %[^\n]s",newvoter.name);

    printf("enter the voter age");
    scanf("%d",&newvoter.age);

    if(newvoter.age<18){
        return -1;// Underage
    }

    newvoter.hasvoted=0;// initially has no votted
    voters[*totalvoters]=newvoter;
    (*totalvoters)++;
    return 1; 
}
 //Candidate Management & Voting

void displaycandidates(candidate candidates[],int size){
    printf("LIST OF CANDIDATES");

    for(int i=0; i<size; i++) {
    printf("%d %s(candidate id: %d)\n",i+1,candidates[i].name,candidates[i].id);
    }
 
}  
void castvote(voter *v,candidate candidates[],int size){
    int candidatechoice;
printf("welcome, %s please enter candidate id to vote:",v->name);
scanf("%d",&candidatechoice);

int validcandidate=0;

for(int i=0;i<size;i++){
    if(candidates[i].id==candidatechoice){
        candidates[i].votecount++;
        v->hasvoted=1;// Mark voter as voted (One vote per user policy
        validcandidate=1;
        printf("\n [success] vote successfully cast for %s\n",candidates[i].name);
        break;
    }
}
if(!validcandidate){
    printf("\n invalid candidate ID selected.\n");
}
}

 //Vote Counting & Winner Declaration
void calculatewinner(candidate candidates[],int size){
    int maxvotes=-1;
    int winnerindex=0;
    int tie=0;

    for(int i=0;i<size;i++){
        if(candidates[i].votecount > maxvotes){
            maxvotes=candidates[i].votecount;
            winnerindex=i;
            tie=0;
        }
        else if(candidates[i].votecount==maxvotes && maxvotes>0)
        {
            tie=1;

        }
    }
    printf("\n===================== \n");
    if(maxvotes==0)
    {
        printf("result: no votes have been cast yet.\n");
    }
    else if(tie)
    {
        printf("result: there is a tie between candidates\n");
    }
    else
    {
        printf("winner annoucement:\n");
        printf("congratulations  to %s with %d votes!\n",candidates[winnerindex].name,candidates[winnerindex].votecount);
        printf("\n============================================== \n");
    }

}
void displaystatistics(candidate candidates[],int size, int totalregisteredvoters){
    int totalvotescast=0;

    for(int i=0;i<size;i++)
    {
        totalvotescast+=candidates[i].votecount;

    }
    printf("\n ELECTION SUMMARY STATISTICS \n");
    printf("total registered voters %d\n",totalregisteredvoters);
    printf("total votes cast: %d",totalvotescast);

    if(totalregisteredvoters>0)
    {
       float turnoutpercentage=((float)totalvotescast/totalregisteredvoters)*100;
       printf("turnout percentage : %.2f %%\n",turnoutpercentage);
    }
    else
    {
        printf("turnout percentage:0.00%%\n");
    }
}
 

    
        
    
        

